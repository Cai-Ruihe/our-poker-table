# Exact origin that serves the browser app. Include scheme and host, but no path.
NORMAL_APP_ORIGIN=https://YOUR-GITHUB-USERNAME.github.io

# Optional Cloudflare Workers/Durable Objects relay (preferred Normal relay).
# Use a WSS origin only; leave blank for a zero-config OSS build.
NORMAL_CLOUD_RELAY_URL=

# Optional Mac Connection Service relay (fallback when Cloudflare is unavailable).
# Use a WSS origin only; leave blank when no Mac fallback is deployed.
NORMAL_MAC_RELAY_URL=

# Legacy compatibility: maps to the Mac/private relay when the two variables
# above are not set. Do not set this together with NORMAL_MAC_RELAY_URL.
NORMAL_CONNECTION_SERVICE_URL=

# Absolute path on this server. The file contains the operator token; this file does not.
RELAY_OPERATOR_TOKEN_FILE=/absolute/path/to/operator-token

# Loopback port used by the host TLS proxy or temporary tunnel.
POKER_CONNECTION_PORT=8787
