{
  "name": "html-poker-app",
  "version": "0.0.0",
  "description": "A trusted-host browser dealer for in-person, play-chip-only Texas Hold'em.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm build:landing && pnpm build:table-side && pnpm build:service && pnpm build:cloudflare-relay && pnpm build:airplane",
    "build:airplane": "node tools/release/build-airplane.mjs",
    "build:landing": "pnpm --filter @html-poker/landing build",
    "build:table-side": "pnpm --filter @html-poker/web build",
    "build:service": "pnpm --filter @html-poker/connection-service build",
    "build:cloudflare-relay": "pnpm --filter @html-poker/cloudflare-connection-service typecheck",
    "brand:verify": "node tools/branding/verify-brand-assets.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm docs:check && pnpm brand:verify && pnpm qa:registry && pnpm qa:controls && pnpm deps:check && pnpm test && pnpm test:cloudflare-relay && pnpm build && pnpm qa:performance",
    "deps:check": "pnpm peers check",
    "dev": "pnpm --filter @html-poker/web dev",
    "docs:check": "node tools/documentation/check-docs.mjs",
    "format": "prettier --write \".github/workflows/**/*.{yml,yaml}\" \"apps/**/*.{css,html,js,json,ts,tsx}\" \"deploy/**/*.{json,yaml,yml}\" \"packages/**/*.{js,json,ts,tsx}\" \"services/**/*.{js,json,ts,tsx}\" \"tests/**/*.{js,json,ts,tsx}\" \"tools/**/*.{js,json,mjs,ts}\" \"*.{js,json,ts,yaml,yml}\"",
    "format:check": "prettier --check \".github/workflows/**/*.{yml,yaml}\" \"apps/**/*.{css,html,js,json,ts,tsx}\" \"deploy/**/*.{json,yaml,yml}\" \"packages/**/*.{js,json,ts,tsx}\" \"services/**/*.{js,json,ts,tsx}\" \"tests/**/*.{js,json,ts,tsx}\" \"tools/**/*.{js,json,mjs,ts}\" \"*.{js,json,ts,yaml,yml}\"",
    "lint": "eslint .",
    "licenses:prod": "pnpm licenses list --prod",
    "preview": "pnpm --filter @html-poker/web preview",
    "relay:create-token": "node tools/operations/create-relay-token.mjs",
    "relay:doctor": "node tools/release/check-live-relay.mjs",
    "qa:browser": "playwright test tests/journey tests/security",
    "qa:controls": "node tools/qa/check-controls.mjs",
    "qa:landing": "playwright test --config apps/landing/playwright.config.ts",
    "qa:live-relay": "node tools/release/check-live-relay.mjs",
    "qa:performance": "node tools/qa/check-performance.mjs",
    "qa:registry": "node tools/qa/check-registry.mjs",
    "qa:release": "pnpm check && pnpm test:coverage && pnpm qa:controls && pnpm qa:browser && pnpm audit:prod",
    "release:local-rc": "pnpm build && pnpm release:manifest",
    "release:configure-table-side": "node tools/release/configure-table-side.mjs",
    "release:manifest": "node tools/release/create-manifest.mjs",
    "release:reproducibility": "node tools/release/verify-reproducibility.mjs",
    "release:verify": "node tools/release/create-manifest.mjs --verify",
    "test": "vitest run",
    "test:cloudflare-relay": "pnpm --filter @html-poker/cloudflare-connection-service test",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@html-poker/accounting": "workspace:*",
    "@html-poker/card-custody": "workspace:*",
    "@html-poker/connection-service": "workspace:*",
    "@html-poker/diagnostics": "workspace:*",
    "@html-poker/game-core": "workspace:*",
    "@html-poker/identity-capabilities": "workspace:*",
    "@html-poker/persistence": "workspace:*",
    "@html-poker/realtime-transport": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
